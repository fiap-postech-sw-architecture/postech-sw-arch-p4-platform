{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EstornoDePagamentoFalhou (dados)",
  "description": "Campo dados da mensagem EstornoDePagamentoFalhou (evento, billing-service -> os-service). O provedor recusou o estorno; a saga vai para FALHA_NA_COMPENSACAO e pede intervenção manual.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ordem_id",
    "pagamento_id",
    "motivo"
  ],
  "properties": {
    "ordem_id": {
      "$ref": "#/$defs/uuid"
    },
    "pagamento_id": {
      "$ref": "#/$defs/uuid"
    },
    "motivo": {
      "$ref": "#/$defs/motivo"
    }
  },
  "$defs": {
    "motivo": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    }
  }
}
