{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReservarPecas (dados)",
  "description": "Campo dados da mensagem ReservarPecas (comando, os-service -> execution-service). Passo T5: a Execução reserva no estoque as peças do orçamento aprovado. Lista vazia vale (orçamento só de serviços).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ordem_id",
    "pecas"
  ],
  "properties": {
    "ordem_id": {
      "$ref": "#/$defs/uuid"
    },
    "pecas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/peca"
      }
    }
  },
  "$defs": {
    "codigo": {
      "type": "string",
      "maxLength": 50,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Código do serviço ou SKU da peça na tabela de preços do Billing (até 50 caracteres)."
    },
    "peca": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku",
        "quantidade"
      ],
      "properties": {
        "sku": {
          "$ref": "#/$defs/codigo"
        },
        "quantidade": {
          "$ref": "#/$defs/quantidade"
        }
      }
    },
    "quantidade": {
      "type": "integer",
      "minimum": 1
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    }
  }
}
