{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PecasReservadas (dados)",
  "description": "Campo dados da mensagem PecasReservadas (evento, execution-service -> os-service). Reserva feita; o OS segue para o pagamento.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ordem_id",
    "reserva_id"
  ],
  "properties": {
    "ordem_id": {
      "$ref": "#/$defs/uuid"
    },
    "reserva_id": {
      "$ref": "#/$defs/uuid"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    }
  }
}
