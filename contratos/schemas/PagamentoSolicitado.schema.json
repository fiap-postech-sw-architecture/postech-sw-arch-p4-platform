{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PagamentoSolicitado (dados)",
  "description": "Campo dados da mensagem PagamentoSolicitado (evento, billing-service -> os-service). Cobrança criada, com o link de checkout para o cliente; a OS passa a AGUARDANDO_PAGAMENTO.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ordem_id",
    "pagamento_id",
    "valor",
    "moeda",
    "checkout_url",
    "expira_em"
  ],
  "properties": {
    "ordem_id": {
      "$ref": "#/$defs/uuid"
    },
    "pagamento_id": {
      "$ref": "#/$defs/uuid"
    },
    "valor": {
      "$ref": "#/$defs/dinheiro"
    },
    "moeda": {
      "const": "BRL",
      "description": "Código ISO 4217 da moeda."
    },
    "checkout_url": {
      "$ref": "#/$defs/uri"
    },
    "expira_em": {
      "$ref": "#/$defs/data_hora"
    }
  },
  "$defs": {
    "data_hora": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|\\+00:00)$",
      "description": "Instante em UTC (RFC 3339 com Z ou +00:00)."
    },
    "dinheiro": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{2}$",
      "description": "Valor decimal com duas casas, em string (nunca float)."
    },
    "uri": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    }
  }
}
