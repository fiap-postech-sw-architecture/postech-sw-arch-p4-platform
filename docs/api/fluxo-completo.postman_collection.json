{
  "info": {
    "name": "PytStop — fluxo completo pela borda (simulador)",
    "description": "RNF-052: abertura ate entrega com tres papeis, oito status e metricas administrativas. Executar por make newman em kind descartavel; valores sensiveis apenas no runtime privado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
