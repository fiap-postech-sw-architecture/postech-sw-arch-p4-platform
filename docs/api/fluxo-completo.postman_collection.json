  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "(function () {",
          "    const nome = pm.info.requestName;",
          "    const get = k => pm.variables.get(k);",
          "    const set = (k, v) => pm.variables.set(k, v);",
          "    const status = ['recebida', 'em_diagnostico', 'aguardando_aprovacao',",
          "        'aguardando_pagamento', 'aguardando_execucao', 'em_execucao', 'finalizada', 'entregue'];",
          "    function check(titulo, condicao) {",
          "        pm.test(titulo, () => { pm.expect(Boolean(condicao)).to.be.true; });",
          "        if (!condicao) pm.execution.setNextRequest(null);",
          "        return Boolean(condicao);",
          "    }",
          "    function limparPoll() {",
          "        pm.variables.unset('poll_inicio');",
          "        pm.variables.unset('poll_tentativas');",
          "        set('offset', 0);",
          "    }",
          "    function poll(pronto) {",
          "        if (pronto) { limparPoll(); return true; }",
          "        const inicio = get('poll_inicio') === undefined ? Date.now() : Number(get('poll_inicio'));",
          "        const tentativas = Number(get('poll_tentativas') || 0) + 1;",
          "        set('poll_inicio', inicio); set('poll_tentativas', tentativas);",
          "        if (check('Evento observado dentro do prazo', Date.now() - inicio < 30000 && tentativas <= 60)) {",
          "            pm.execution.setNextRequest(pm.info.requestId);",
          "        }",
          "        return false;",
          "    }",
          "    const autenticacao = nome.startsWith('Login ') || nome.startsWith('Registrar ');",
          "    if (autenticacao && pm.response.code === 429) {",
          "        const inicio = get('retry_inicio') === undefined ? Date.now() : Number(get('retry_inicio'));",
          "        set('retry_inicio', inicio);",
          "        const restante = 70000 - (Date.now() - inicio);",
          "        if (!check('Autenticacao dentro do prazo de rate limit', restante > 0)) return;",
          "        const raw = pm.response.headers.get('Retry-After');",
          "        const segundos = raw !== null && raw !== undefined && String(raw).trim() !== '' && Number.isFinite(Number(raw)) ? Math.max(1, Number(raw)) : 5;",
          "        setTimeout(() => pm.execution.setNextRequest(pm.info.requestId), Math.min(restante, segundos * 1000));",
          "        return;",
          "    }",
          "    pm.variables.unset('retry_inicio');",
          "    const criado = ['Registrar atendente', 'Registrar mecanico', 'Preco servico', 'Preco peca', 'Estoque inicial', 'Cliente', 'Veiculo', 'Abrir OS'];",
          "    const esperado = nome === 'Metricas sem token' ? 401 : ['Metricas atendente', 'Metricas mecanico'].includes(nome) ? 403 : criado.includes(nome) ? 201 : 200;",
          "    if (!check('HTTP esperado', pm.response.code === esperado)) return;",
          "    if (esperado === 401 || esperado === 403) return;",
          "    if (nome === 'Checkout') {",
          "        check('Pagina HTML do checkout', String(pm.response.headers.get('Content-Type') || '').toLowerCase().includes('text/html'));",
          "        return;",
          "    }",
          "    const b = pm.response.json();",
          "    function urlLocal(link, caminho) {",
          "        if (typeof link !== 'string') return false;",
          "        const parse = require('url').parse;",
          "        const u = parse(link, true), base = parse(get('baseUrl'));",
          "        return u.protocol === base.protocol && u.host === base.host && !u.auth && !u.hash && caminho(u);",
          "    }",
          "    function mesmaOs() { return check('Mesma OS', b.ordem_id === get('ordem_id')); }",
          "    function lista(presente) {",
          "        if (!check('Pagina valida', Array.isArray(b.items) && Number.isInteger(b.total) && b.total >= 0 && Number.isInteger(b.offset) && Number.isInteger(b.limit) && b.limit > 0)) return;",
          "        const encontrou = b.items.some(x => x.ordem_id === get('ordem_id'));",
          "        const fim = b.items.length === 0 || b.offset + b.items.length >= b.total;",
          "        if (encontrou || fim) {",
          "            set('offset', 0);",
          "            if (!presente) { check('Fora da fila antes do pagamento', !encontrou); limparPoll(); }",
          "            else poll(encontrou);",
          "        } else { set('offset', b.offset + b.items.length); poll(false); }",
          "    }",
          "    if (nome.startsWith('Saude ')) {",
          "        if (nome === 'Saude billing') check('Somente simulador', b.modo === 'simulado');",
          "    } else if (nome.startsWith('Login ')) {",
          "        if (check('JWT emitido', b.token_type === 'bearer' && typeof b.access_token === 'string' && b.access_token.length > 0)) set('jwt_' + nome.split(' ')[1], b.access_token);",
          "    } else if (nome.startsWith('Registrar ')) {",
          "        check('Papel registrado', b.papel === nome.split(' ')[1] && typeof b.id === 'string' && b.id.length > 0);",
          "    } else if (nome === 'Preco servico') {",
          "        check('Preco do servico', b.codigo === get('servico') && b.preco === '120.00');",
          "    } else if (nome === 'Preco peca') {",
          "        check('Preco da peca', b.sku === get('peca') && b.preco === '45.00');",
          "    } else if (nome === 'Estoque inicial') {",
          "        check('Estoque inicial sem reserva', b.sku === get('peca') && b.quantidade_disponivel === 10 && b.quantidade_reservada === 0);",
          "    } else if (nome === 'Cliente' || nome === 'Veiculo') {",
          "        if (check('Identificador criado', typeof b.id === 'string' && b.id.length > 0)) set(nome === 'Cliente' ? 'cliente_id' : 'veiculo_id', b.id);",
          "    } else if (nome === 'Abrir OS') {",
          "        if (check('OS recebida para cliente e veiculo', b.status === 'recebida' && b.etapa === 'aguardando_diagnostico' && b.cliente_id === get('cliente_id') && b.veiculo_id === get('veiculo_id') && typeof b.id === 'string' && b.id.length > 0)) set('ordem_id', b.id);",
          "    } else if (nome === 'Fila diagnostico' || nome === 'Fila execucao' || nome === 'Fora da fila') {",
          "        lista(nome !== 'Fora da fila');",
          "    } else if (nome.startsWith('OS ')) {",
          "        const alvo = nome.slice(3), indice = status.indexOf(b.status), esperado = status.indexOf(alvo);",
          "        if (!check('OS em estado conhecido sem cancelamento', b.id === get('ordem_id') && indice >= 0 && indice <= esperado)) return;",
          "        const resumoPronto = alvo !== 'aguardando_pagamento' || Boolean(b.pagamento && b.pagamento.status === 'solicitado');",
          "        if (poll(b.status === alvo && resumoPronto)) {",
          "            if (alvo === 'aguardando_aprovacao') {",
          "                if (check('Orcamento de 210 reais', b.orcamento && b.orcamento.total === '210.00' && typeof b.orcamento.orcamento_id === 'string')) {",
          "                    set('orcamento_id', b.orcamento.orcamento_id); set('os_link_decisao', b.orcamento.link_decisao);",
          "                }",
          "            } else if (alvo === 'aguardando_pagamento') {",
          "                set('pagamento_id', b.pagamento.pagamento_id);",
          "            }",
          "        }",
          "    } else if (nome === 'Iniciar diagnostico' || nome === 'Concluir diagnostico' || nome === 'Iniciar execucao' || nome === 'Finalizar execucao') {",
          "        const estados = {'Iniciar diagnostico':'EM_ANDAMENTO', 'Concluir diagnostico':'CONCLUIDO', 'Iniciar execucao':'EM_EXECUCAO', 'Finalizar execucao':'FINALIZADA'};",
          "        mesmaOs(); check('Estado da Execucao', b.status === estados[nome]);",
          "    } else if (nome === 'Orcamento') {",
          "        mesmaOs();",
          "        check('Orcamento e moeda', b.id === get('orcamento_id') && b.total === '210.00' && b.moeda === 'BRL');",
          "        check('Linhas do diagnostico precificadas', Array.isArray(b.linhas) && b.linhas.length === 2 &&",
          "            b.linhas.some(x => x.tipo === 'servico' && x.codigo === get('servico') && x.quantidade === 1 && x.preco_unitario === '120.00' && x.subtotal === '120.00') &&",
          "            b.linhas.some(x => x.tipo === 'peca' && x.codigo === get('peca') && x.quantidade === 2 && x.preco_unitario === '45.00' && x.subtotal === '90.00'));",
          "    } else if (nome === 'Buscar email') {",
          "        const mensagens = b.messages || [];",
          "        if (!check('Lista de emails valida', Array.isArray(mensagens))) return;",
          "        const email = mensagens.find(x => typeof x.Subject === 'string' && x.Subject.toLowerCase().includes('orçamento'));",
          "        if (poll(Boolean(email))) set('message_id', email.ID);",
          "    } else if (nome === 'Ler email') {",
          "        const achado = String(b.Text || '').match(/https?:\\/\\/[^\\s\"'<>]+\\/api\\/v1\\/publico\\/orcamentos\\/[A-Za-z0-9_.~-]+/);",
          "        const link = achado && achado[0];",
          "        if (check('Link do email na borda e igual ao da OS', link === get('os_link_decisao') && urlLocal(link, u => /^\\/billing\\/api\\/v1\\/publico\\/orcamentos\\/[A-Za-z0-9_.~-]+$/.test(u.pathname) && !u.search))) set('link_decisao', link);",
          "    } else if (nome === 'Orcamento publico') {",
          "        check('Orcamento publico correto', b.id === get('orcamento_id') && b.total === '210.00' && b.moeda === 'BRL');",
          "    } else if (nome === 'Aprovar orcamento') {",
          "        check('Orcamento aprovado', b.status === 'APROVADO');",
          "    } else if (nome === 'Estoque reservado' || nome === 'Estoque baixado') {",
          "        const reservado = nome === 'Estoque reservado';",
          "        poll(b.sku === get('peca') && b.quantidade_disponivel === (reservado ? 10 : 8) && b.quantidade_reservada === (reservado ? 2 : 0) && b.quantidade_livre === 8);",
          "    } else if (nome === 'Pagamento solicitado') {",
          "        if (!mesmaOs()) return;",
          "        if (!check('Cobranca simulada correta', b.id === get('pagamento_id') && b.orcamento_id === get('orcamento_id') && b.status === 'SOLICITADO' && b.valor === '210.00' && b.moeda === 'BRL' && b.provedor === 'simulado')) return;",
          "        if (check('Checkout local assinado', urlLocal(b.checkout_url, u => u.pathname === '/billing/simulador/checkout/' + get('pagamento_id') && typeof u.query.token === 'string' && u.query.token.length > 0 && Object.keys(u.query).length === 1))) {",
          "            set('checkout_url', b.checkout_url); set('checkout_token', require('url').parse(b.checkout_url, true).query.token);",
          "        }",
          "    } else if (nome === 'Aprovar pagamento' || nome === 'Pagamento confirmado') {",
          "        mesmaOs(); check('Pagamento confirmado', b.id === get('pagamento_id') && b.status === 'CONFIRMADO');",
          "    } else if (nome === 'Entregar') {",
          "        check('Veiculo entregue', b.id === get('ordem_id') && b.status === 'entregue');",
          "    } else if (nome === 'Saga concluida') {",
          "        if (mesmaOs()) poll(b.etapa === 'concluida');",
          "    } else if (nome === 'Historico') {",
          "        mesmaOs(); check('Oito status em ordem', Array.isArray(b.mudancas) && JSON.stringify(b.mudancas.map(x => x.para)) === JSON.stringify(status) && b.mudancas[0].de === null);",
          "    } else if (nome === 'Metricas admin') {",
          "        const nove = [...status, 'cancelada'].sort();",
          "        const contagens = b.por_status, medias = b.tempo_medio_por_status_segundos;",
          "        check('Contrato das metricas', JSON.stringify(Object.keys(b).sort()) === JSON.stringify(['por_status', 'tempo_medio_por_status_segundos', 'total']) && contagens && medias && typeof contagens === 'object' && typeof medias === 'object' && !Array.isArray(medias) &&",
          "            JSON.stringify(Object.keys(contagens).sort()) === JSON.stringify(nove) && Object.values(contagens).every(x => Number.isInteger(x) && x >= 0) &&",
          "            Number.isInteger(b.total) && b.total === Object.values(contagens).reduce((a,x) => a+x, 0) && contagens.entregue >= 1 &&",
          "            Object.keys(medias).every(x => nove.includes(x)) && Object.values(medias).every(x => typeof x === 'number' && Number.isFinite(x) && x >= 0));",
          "    } else { check('Etapa conhecida', false); }",
          "})();"
        ]
      }
    },
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const nome = pm.info.requestName;",
          "const espera = nome.startsWith('OS ') || ['Fila diagnostico', 'Fila execucao',",
          "    'Fora da fila', 'Estoque reservado', 'Estoque baixado', 'Buscar email',",
          "    'Saga concluida'].includes(nome);",
          "if (espera && pm.variables.get('poll_inicio') === undefined) {",
          "    pm.variables.set('poll_inicio', Date.now());",
          "    pm.variables.set('poll_tentativas', 0);",
          "}"
        ]
      }
    }
  ],
