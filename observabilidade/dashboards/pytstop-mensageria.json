{
  "uid": "pytstop-mensageria",
  "title": "PytStop - Mensageria (serviços)",
  "description": "Dashboard Mensageria do ADR-043, parte dos serviços: mensagens publicadas e consumidas por tipo, retry, DLQ, outbox e reconexões ao broker. As filas e o dead-letter do RabbitMQ estão no dashboard da plataforma. Documentação painel a painel em observabilidade/README.md.",
  "tags": [
    "pytstop",
    "tecnico"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": false,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "pytstop"
      ],
      "targetBlank": false,
      "title": "Dashboards PytStop",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Publicadas por tipo (msg/s)",
      "description": "Mensagens que os relays publicaram e o broker confirmou, por tipo. Os degraus mostram os passos da saga.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (tipo) (rate(pytstop_mensagens_publicadas_total[$__rate_interval]))",
          "legendFormat": "{{tipo}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "title": "Consumidas por resultado (msg/s)",
      "description": "Por serviço: processada, duplicada (id já visto), ignorada (fora da etapa ou descompasso de estado), retry e dlq. Retry ou dlq constante é dependência fora ou mensagem inválida.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, resultado) (rate(pytstop_mensagens_consumidas_total[$__rate_interval]))",
          "legendFormat": "{{namespace}} {{resultado}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Retry por nível (msg/s)",
      "description": "Cópias para as filas de retry por atraso (1s, 5s, 15s, 60s, 300s). Só 1s e 5s é falha passageira; 60s e 300s é dependência fora por minutos, e o passo seguinte é a DLQ.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (nivel) (label_replace(rate(rabbitmq_queue_exchange_messages_published_total{queue=~\".+[.]retry[.].+\"}[$__rate_interval]), \"nivel\", \"$1\", \"queue\", \".+[.]retry[.](.+)\"))",
          "legendFormat": "{{nivel}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Para a DLQ por tipo",
      "description": "Mensagens que cada consumidor mandou para a DLQ no período, por tipo. A profundidade de cada DLQ está no dashboard da plataforma; redrive pelo runbook.",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.001
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, tipo) (increase(pytstop_mensagens_consumidas_total{resultado=\"dlq\"}[$__range]))",
          "legendFormat": "{{namespace}} {{tipo}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 5,
      "title": "Outbox pendente",
      "description": "Linhas da outbox esperando o relay; a idade da mais antiga está no painel 7 e, acima de 300 s por 5 min, dispara Outbox parada (broker fora ou relay parado). Vale o maior valor do serviço (o Billing exporta da API e do relay). Com o relay parado a série do OS e da Execução some; com o banco fora, a do Billing some e a do OS e da Execução vira NaN, e nem a ausência nem o NaN é zero.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "sem dado"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (namespace) (outbox_pendentes)",
          "legendFormat": "{{namespace}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Outbox dead",
      "description": "Linhas que esgotaram as tentativas de publicação; precisam do operador (runbook da saga). Dispara Outbox com mensagem dead. A série some com o relay parado; com o banco fora, some no Billing e vira NaN no OS e na Execução, e o painel mostra sem leitura.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 8,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "sem leitura",
                  "color": "text"
                }
              }
            }
          ],
          "noValue": "sem dado"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (namespace) (outbox_dead)",
          "legendFormat": "{{namespace}}",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 7,
      "title": "Idade da pendente mais antiga",
      "description": "Espera da linha pendente mais antiga de cada serviço; com tráfego normal fica em segundos. Vem da API, que segue exportando com o relay parado, e some só com o banco fora.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 300
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "noValue": "sem dado"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (namespace) (pytstop_outbox_mais_antiga_segundos)",
          "legendFormat": "{{namespace}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "title": "Reconexões ao broker",
      "description": "Esperas antes de reconectar, por componente (relay ou consumidor) e hora. Crescimento contínuo é processo preso em reconexão (credencial, permissão ou broker fora).",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (namespace, componente) (increase(pytstop_reconexoes_ao_broker_total[1h]))",
          "legendFormat": "{{namespace}} {{componente}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
