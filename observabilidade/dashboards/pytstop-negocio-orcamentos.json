{
  "uid": "pytstop-negocio-orcamentos",
  "title": "PytStop Negócio - Orçamentos",
  "description": "Dashboard de negócio do PytStop (ADR-043), com a janela de 7 dias. Documentação painel a painel em observabilidade/negocio.md.",
  "tags": [
    "pytstop",
    "negocio"
  ],
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": false,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "pytstop"
      ],
      "targetBlank": false,
      "title": "Dashboards PytStop",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Orçamentos por desfecho",
      "description": "Orçamentos gerados no período e o desfecho de cada um, contados quando o OS processa o evento do Billing. Falha na geração é serviço ou peça sem preço na tabela do Billing, e a OS é cancelada.",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pytstop_mensagens_consumidas_total{resultado=\"processada\", tipo=\"OrcamentoGerado\"}[$__range]))",
          "legendFormat": "Gerados",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pytstop_mensagens_consumidas_total{resultado=\"processada\", tipo=\"OrcamentoAprovado\"}[$__range]))",
          "legendFormat": "Aprovados",
          "instant": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pytstop_mensagens_consumidas_total{resultado=\"processada\", tipo=\"OrcamentoRecusado\"}[$__range]))",
          "legendFormat": "Recusados",
          "instant": true
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pytstop_mensagens_consumidas_total{resultado=\"processada\", tipo=\"OrcamentoExpirado\"}[$__range]))",
          "legendFormat": "Expirados",
          "instant": true
        },
        {
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pytstop_mensagens_consumidas_total{resultado=\"processada\", tipo=\"GeracaoDeOrcamentoFalhou\"}[$__range]))",
          "legendFormat": "Falha na geração",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "Taxa de aprovação",
      "description": "Aprovados sobre aprovados, recusados e expirados no período; expirado conta como não aprovado. Limiares de referência da demonstração.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.7
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "sem eventos no período",
                  "color": "text"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(pytstop_mensagens_consumidas_total{resultado=\"processada\", tipo=\"OrcamentoAprovado\"}[$__range])) / sum(increase(pytstop_mensagens_consumidas_total{resultado=\"processada\", tipo=~\"OrcamentoAprovado|OrcamentoRecusado|OrcamentoExpirado\"}[$__range]))",
          "legendFormat": "Aprovação",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "title": "Tempo até a decisão",
      "description": "Tempo entre a geração do orçamento e a decisão pelo link ou pelo atendente, por decisão: média e percentil 90. A média é exata. O percentil é estimado pelos baldes do histograma (de 0,1 s a 72 h) e só aparece com 10 decisões ou mais no período, porque com menos ele só diz em que balde elas caíram. O orçamento expira em 72 h; expirados não entram aqui (painel 1).",
      "type": "bargauge",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 86400
              },
              {
                "color": "red",
                "value": 172800
              }
            ]
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "sem eventos no período",
                  "color": "text"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (decisao) (increase(pytstop_orcamentos_tempo_decisao_segundos_sum[$__range])) / sum by (decisao) (increase(pytstop_orcamentos_tempo_decisao_segundos_count[$__range]))",
          "legendFormat": "média {{decisao}}",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.9, sum by (le, decisao) (increase(pytstop_orcamentos_tempo_decisao_segundos_bucket[$__range]))) and on (decisao) (sum by (decisao) (increase(pytstop_orcamentos_tempo_decisao_segundos_count[$__range])) >= 10)",
          "legendFormat": "p90 {{decisao}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "title": "Aguardando decisão agora",
      "description": "OS com orçamento enviado esperando a decisão e a espera da mais antiga. Perto de 72 h ela expira e a OS é cancelada: vale lembrar o cliente.",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 172800
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pytstop_saga_ativas{etapa=\"aguardando_decisao\"})",
          "legendFormat": "OS aguardando",
          "instant": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(pytstop_saga_etapa_mais_antiga_segundos{etapa=\"aguardando_decisao\"})",
          "legendFormat": "Espera da mais antiga",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    }
  ]
}
